    /* 몽환적인 보름달 */
    .login-page-wrapper::after {
      content: '';
      position: absolute;
      top: 12%;
      right: 10%;
      width: 120px;
      height: 120px;
      /* 보름달 모양 */
      background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.7) 40%, transparent 70%);
      border-radius: 50%;
      box-shadow: 
        0 0 40px rgba(255,255,255,0.4),
        0 0 80px rgba(255,255,255,0.2),
        inset -20px -20px 0 rgba(255,255,255,0.1);
      filter: blur(1px);
      animation: moonGlow 6s ease-in-out infinite;
      pointer-events: none;
      z-index: 1;
    }
    
    @keyframes moonGlow {
      0%, 100% { 
        opacity: 0.8;
        transform: scale(1) translateY(0);
      }
      50% { 
        opacity: 1;
        transform: scale(1.05) translateY(-5px);
      }
    }
    

    .login-brand {
      position: absolute;
      top: 48px;
      left: 64px;
      z-index: 10;
      color: #FFFFFF;
    }

    .login-brand-text {
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 4px;
      line-height: 1.2;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .login-brand-text .line1 {
      display: block;
      margin-bottom: 4px;
    }

    .login-brand-text .line2 {
      display: block;
    }

    .login-card {
      position: relative;
      z-index: 5;
      width: 460px;
      min-height: 460px;
      background: #FFFFFF;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      padding: 40px;
      display: flex;
      flex-direction: column;
    }

    .login-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid #E5E7EB;
    }

    .login-card-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .login-card-logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #6A5AE0 0%, #8B7CF6 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #FFFFFF;
    }

    .login-card-title {
      display: flex;
      flex-direction: column;
    }

    .login-card-title h1 {
      font-size: 20px;
      font-weight: 700;
      color: #111827;
      margin: 0;
      line-height: 1.3;
    }

    .login-card-title p {
      font-size: 13px;
      color: #6B7280;
      margin: 4px 0 0 0;
    }

    .login-lang-tabs {
      display: flex;
      gap: 0;
      margin-bottom: 28px;
      border-bottom: 2px solid #E5E7EB;
    }

    .login-lang-tab {
      padding: 12px 24px;
      font-size: 14px;
      font-weight: 500;
      color: #6B7280;
      background: none;
      border: none;
      cursor: pointer;
      position: relative;
      transition: var(--transition);
    }

    .login-lang-tab.active {
      color: #6A5AE0;
      font-weight: 600;
    }

    .login-lang-tab.active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      height: 2px;
      background: #6A5AE0;
    }

    .login-form-container {
      display: flex;
      gap: 16px;
      margin-bottom: 20px;
    }

    .login-form-inputs {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .login-input {
      width: 100%;
      height: 48px;
      padding: 0 14px;
      border: 1px solid #D1D5DB;
      border-radius: 12px;
      font-size: 15px;
      font-family: inherit;
      transition: var(--transition);
      background: #FFFFFF;
    }

    .login-input:focus {
      outline: none;
      border-color: #6A5AE0;
      box-shadow: 0 0 0 3px rgba(106, 90, 224, 0.1);
    }

    .login-input::placeholder {
      color: #9CA3AF;
    }

    .login-submit-btn {
      width: 120px;
      height: 108px;
      background: linear-gradient(135deg, #1E3A8A 0%, #4C1D95 100%);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      font-family: inherit;
    }

    .login-submit-btn:hover {
      background: linear-gradient(135deg, #2563EB 0%, #5B21B6 100%);
      transform: scale(1.02);
      box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3);
    }

    .login-options {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .login-checkbox-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .login-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: #6A5AE0;
    }

    .login-checkbox-label {
      font-size: 14px;
      color: #4B5563;
      cursor: pointer;
    }

    .login-signup-link {
      font-size: 14px;
      color: #6B7280;
    }

    .login-signup-link a {
      color: #6A5AE0;
      text-decoration: none;
      font-weight: 500;
      transition: var(--transition);
    }

    .login-signup-link a:hover {
      color: #4C1D95;
      text-decoration: underline;
    }

    .login-info-box {
      width: 100%;
      background: #111827;
      border-radius: 12px;
      padding: 20px;
      margin-top: auto;
    }

    .login-info-box h3 {
      font-size: 15px;
      font-weight: 600;
      color: #FFFFFF;
      margin: 0 0 16px 0;
    }

    .login-info-box ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .login-info-box li {
      font-size: 13px;
      color: #D1D5DB;
      line-height: 1.7;
      margin-bottom: 10px;
      padding-left: 16px;
      position: relative;
    }

    .login-info-box li:last-child {
      margin-bottom: 0;
    }

    .login-info-box li::before {
      content: '•';
      position: absolute;
      left: 0;
      color: #6A5AE0;
      font-weight: bold;
    }

    .login-error {
      background: #FEE2E2;
      color: #991B1B;
      padding: 12px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
      font-size: 14px;
      border-left: 4px solid #EF4444;
    }

    .login-footer {
      text-align: center;
      margin-top: 24px;
      font-size: 12px;
      color: #9CA3AF;
    }

    @media (max-width: 768px) {
      .login-brand {
        top: 24px;
        left: 24px;
      }

      .login-brand-text {
        font-size: 24px;
        letter-spacing: 2px;
      }

      .login-card {
        width: 90%;
        max-width: 420px;
        padding: 32px 24px;
      }

      .login-form-container {
        flex-direction: column;
      }

      .login-submit-btn {
        width: 100%;
        height: 48px;
      }
    }
  </style>
</head>
<body class="login-page">
  <div class="login-page-wrapper">
    <!-- 별 레이어 2 - 작은 별들 (느린 반짝임) -->
    <div class="stars-layer-2"></div>
    
    <!-- 왼쪽 상단 브랜드 -->
    <div class="login-brand">
      <div class="login-brand-text">
        <span class="line1">FORTUNE</span>
        <span class="line2">FOR YOU</span>
      </div>
    </div>

    <!-- 중앙 로그인 카드 -->
    <div class="login-card">
      <!-- 카드 상단 헤더 -->
      <div class="login-card-header">
        <div class="login-card-logo">
          <div class="login-card-logo-icon">💜</div>
          <div class="login-card-title">
            <h1>Fortune For You</h1>
            <p>사주 기반 소개팅 플랫폼</p>
          </div>
        </div>
      </div>

      <!-- 언어 탭 -->
      <div class="login-lang-tabs">
        <span class="login-lang-tab active">KR</span>
      </div>

      <!-- 에러 메시지 -->
      <% if (locals.error) { %>
        <div class="login-error">
          <%= error %>
        </div>
      <% } %>

      <!-- 로그인 폼 -->
      <form method="POST" action="/auth/login">
        <div class="login-form-container">
          <div class="login-form-inputs">
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="login-input" 
              placeholder="이메일을 입력하세요"
              required
            >
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="login-input" 
              placeholder="비밀번호를 입력하세요"
              required
            >
          </div>
          <button type="submit" class="login-submit-btn">
            로그인
          </button>
        </div>

        <!-- 회원가입 링크 -->
        <div class="login-options" style="justify-content: flex-end;">
          <div class="login-signup-link">
            아직 계정이 없으신가요? <a href="/auth/signup">회원가입</a>
          </div>
        </div>
      </form>

      <!-- 하단 안내 박스 -->
      <div class="login-info-box">
