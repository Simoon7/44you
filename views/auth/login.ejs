    @keyframes starsTwinkleSlow {
      0% { 
        opacity: 0.4;
        filter: brightness(0.7);
      }
      30% { 
        opacity: 0.8;
        filter: brightness(1.1);
      }
      60% { 
        opacity: 1;
        filter: brightness(1.4);
      }
      80% { 
        opacity: 0.7;
        filter: brightness(1.0);
      }
      100% { 
        opacity: 0.4;
        filter: brightness(0.7);
      }
