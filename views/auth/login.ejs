    @keyframes starsTwinkle {
      0% { 
        opacity: 0.5;
        filter: brightness(0.8);
      }
      25% { 
        opacity: 0.9;
        filter: brightness(1.2);
      }
      50% { 
        opacity: 1;
        filter: brightness(1.5);
      }
      75% { 
        opacity: 0.85;
        filter: brightness(1.1);
      }
      100% { 
        opacity: 0.5;
        filter: brightness(0.8);
      }
    }
    
