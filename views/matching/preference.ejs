<%- include('../layout/header') %>

<div class="container">
  <div class="preference-container">
    <h2>성향 보기</h2>
    
    <div class="birth-form-container">
      <form action="/matching/register-saju" method="POST" class="birth-form">
        <h3>버튼</h3>
        <p class="form-description">버튼 클릭시 자신의 성향 내용 표시</p>
        
        <div class="form-row">
          <div class="form-group">
            <label for="birthYear">년도</label>
            <input type="number" id="birthYear" name="birthYear" 
                   value="<%= user.birthYear || '' %>" 
                   placeholder="예: 1995" min="1900" max="2025" required>
          </div>
          
          <div class="form-group">
            <label for="birthMonth">월</label>
            <input type="number" id="birthMonth" name="birthMonth" 
                   value="<%= user.birthMonth || '' %>" 
                   placeholder="1-12" min="1" max="12" required>
          </div>
          
          <div class="form-group">
            <label for="birthDay">일</label>
            <input type="number" id="birthDay" name="birthDay" 
                   value="<%= user.birthDay || '' %>" 
                   placeholder="1-31" min="1" max="31" required>
          </div>
        </div>
        
        <div class="form-group">
          <label for="gender">성별</label>
          <select id="gender" name="gender" required>
            <option value="">선택하세요</option>
            <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>남성</option>
            <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>여성</option>
            <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>기타</option>
          </select>
        </div>
        
        <% if (message) { %>
          <div class="message"><%= message %></div>
        <% } %>
        
        <button type="submit" class="btn btn-primary">저장하기</button>
      </form>
    </div>

    <!-- 두 사람 궁합 분석 섹션 -->
    <div class="compatibility-section">
      <h3>두 사람 궁합 분석</h3>
      <p class="form-description">두 사람의 생년월일과 성별을 입력하여 궁합 점수를 확인하세요</p>

      <div class="compatibility-form">
        <!-- 첫 번째 사람 -->
        <div class="person-form">
          <h4>첫 번째 사람</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="person1-year">년도</label>
              <input type="number" id="person1-year" placeholder="예: 1995" min="1900" max="2025">
            </div>
            <div class="form-group">
              <label for="person1-month">월</label>
              <input type="number" id="person1-month" placeholder="1-12" min="1" max="12">
            </div>
            <div class="form-group">
              <label for="person1-day">일</label>
              <input type="number" id="person1-day" placeholder="1-31" min="1" max="31">
            </div>
          </div>
          <div class="form-group">
            <label for="person1-gender">성별</label>
            <select id="person1-gender">
              <option value="">선택하세요</option>
              <option value="남">남성</option>
              <option value="여">여성</option>
            </select>
          </div>
        </div>

        <!-- 두 번째 사람 -->
        <div class="person-form">
          <h4>두 번째 사람</h4>
          <div class="form-row">
            <div class="form-group">
              <label for="person2-year">년도</label>
              <input type="number" id="person2-year" placeholder="예: 1995" min="1900" max="2025">
            </div>
            <div class="form-group">
              <label for="person2-month">월</label>
              <input type="number" id="person2-month" placeholder="1-12" min="1" max="12">
            </div>
            <div class="form-group">
              <label for="person2-day">일</label>
              <input type="number" id="person2-day" placeholder="1-31" min="1" max="31">
            </div>
          </div>
          <div class="form-group">
            <label for="person2-gender">성별</label>
            <select id="person2-gender">
              <option value="">선택하세요</option>
              <option value="남">남성</option>
              <option value="여">여성</option>
            </select>
          </div>
        </div>
      </div>

      <button type="button" class="btn btn-secondary" id="analyze-btn">궁합 분석하기</button>

      <!-- 분석 결과 표시 영역 -->
      <div id="result-container" class="result-container" style="display: none;">
        <div class="result-card">
          <h4>궁합 분석 결과</h4>
          <div class="score-display">
            <div class="score-circle" id="score-circle">
              <span class="score-text" id="score-text">--</span>
              <span class="score-label">점</span>
            </div>
          </div>
          <div class="compatibility-level" id="compatibility-level"></div>
          <div class="result-message" id="result-message"></div>
        </div>
      </div>

      <!-- 로딩 표시 -->
      <div id="loading-container" class="loading-container" style="display: none;">
        <div class="loading-spinner"></div>
        <p>궁합을 분석하고 있습니다...</p>
      </div>

      <!-- 에러 메시지 -->
      <div id="error-container" class="error-container" style="display: none;">
        <p class="error-message" id="error-message"></p>
      </div>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>

<script>
// 궁합 분석 기능
document.getElementById('analyze-btn').addEventListener('click', async function() {
  // 입력값 검증
  const person1 = {
    year: document.getElementById('person1-year').value,
    month: document.getElementById('person1-month').value,
    day: document.getElementById('person1-day').value,
    gender: document.getElementById('person1-gender').value
  };

  const person2 = {
    year: document.getElementById('person2-year').value,
    month: document.getElementById('person2-month').value,
    day: document.getElementById('person2-day').value,
    gender: document.getElementById('person2-gender').value
  };

  // 필수 필드 검증
  if (!person1.year || !person1.month || !person1.day || !person1.gender ||
      !person2.year || !person2.month || !person2.day || !person2.gender) {
    showError('모든 정보를 입력해주세요.');
    return;
  }

  // 로딩 표시
  showLoading();

  try {
    const response = await fetch('/matching/compat', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        a: person1,
        b: person2,
        useLunar: true,
        debug: false
      })
    });

    const data = await response.json();

    if (data.ok) {
      showResult(data.compat.matching_score);
    } else {
      showError(data.error || '분석 중 오류가 발생했습니다.');
    }

  } catch (error) {
    console.error('API 호출 오류:', error);
    showError('네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요.');
  } finally {
    hideLoading();
  }
});

// 결과 표시 함수들
function showResult(score) {
  hideError();
  hideLoading();

  const scoreText = document.getElementById('score-text');
  const compatibilityLevel = document.getElementById('compatibility-level');
  const resultMessage = document.getElementById('result-message');
  const scoreCircle = document.getElementById('score-circle');

  // 점수 표시
  scoreText.textContent = Math.round(score);

  // 궁합 레벨 결정 (궁합 상세보기와 동일한 로직)
  let level, message, color;
  
  // ==================== 180 이상 ====================
  if (score >= 180) {
    level = '하늘이 내린 천생연분 👑';
    message = '처음 만난 순간부터 이상하게 잘 맞는 느낌을 줄 수 있는 궁합입니다. 말투나 표현 방식이 비슷해, 깊은 이야기를 하지 않아도 서로의 기분을 자연스럽게 읽게 되는 편입니다. 일상적인 농담이나 사소한 대화에서도 공감대가 쉽게 만들어지고, 함께 있을 때 안정감과 설렘이 동시에 유지될 가능성이 높습니다.';
    color = '#1A237E';
  }
  // ==================== 165 이상 ====================
  else if (score >= 165) {
    level = '운명에 가까운 궁합 💍';
    message = '가치관과 관계를 대하는 태도가 비슷해, 중요한 이야기를 나눌 때에도 서로를 이해하기 쉬운 궁합입니다. 서로 다른 점이 있어도 크게 부딪히지 않고, 자연스럽게 조율되는 흐름을 갖고 있습니다. 함께 미래를 이야기할 때 부담감보다는 기대감이 먼저 떠오르기 쉬운 조합입니다.';
    color = '#004D40';
  }
  // ==================== 150 이상 ====================
  else if (score >= 150) {
    level = '완벽에 가까운 궁합 💎';
    message = '성향과 생활 패턴이 잘 맞아, 함께 시간을 보낼 때 에너지 소모가 적고 편안함이 크게 느껴지는 궁합입니다. 의견 차이가 생기더라도 감정을 상하게 하기보다, 서로의 입장을 차분히 듣고 조율할 수 있는 여지가 많습니다. 관계가 길어질수록 서로에 대한 믿음과 의지가 커질 수 있는 조합입니다.';
    color = '#1B5E20';
  }
  // ==================== 135 이상 ====================
  else if (score >= 135) {
    level = '매우 좋은 궁합 💖';
    message = '대부분의 상황에서 리듬이 잘 맞고, 서로의 말과 행동이 크게 부담되지 않는 관계입니다. 상대의 장점을 자연스럽게 보게 되며, 단점도 크게 문제 삼지 않고 받아들이기 쉬운 편입니다. 함께 있을 때 마음이 편안해지고, 무리하지 않아도 관계가 조금씩 깊어질 가능성이 높은 궁합입니다.';
    color = '#2E7D32';
  }
  // ==================== 120 이상 ====================
  else if (score >= 120) {
    level = '좋은 궁합 🙂';
    message = '대화가 자연스럽게 이어지고, 큰 갈등 없이 편안하게 만남을 이어갈 수 있는 궁합입니다. 서로의 일상을 나누는 데 부담이 적고, 가벼운 관심 표현만으로도 관계가 조금씩 발전할 여지가 있습니다. 특별히 극적인 케미는 아닐 수 있지만, 안정적인 흐름을 선호하는 사람에게 잘 맞는 조합입니다.';
    color = '#43A047';
  }
  // ==================== 105 이상 ====================
  else if (score >= 105) {
    level = '알아갈수록 편해지는 궁합 🤝';
    message = '처음에는 다소 거리를 두고 관찰하게 될 수 있지만, 대화를 이어가다 보면 점점 편해지는 궁합입니다. 서로의 표현 방식을 이해하는 데 약간의 시간이 필요하지만, 일단 한 번 익숙해지면 안정감이 커질 가능성이 있습니다. 서두르지 않고 천천히 알아가는 흐름에 어울리는 조합입니다.';
    color = '#689F38';
  }
  // ==================== 95 이상 ====================
  else if (score >= 95) {
    level = '다른 점이 자연스러운 궁합 🧩';
    message = '생활 스타일이나 취향에서 서로 다른 부분이 눈에 띌 수 있지만, 그 차이가 곧바로 불편함으로 이어지지 않는 관계입니다. "나와 조금 다르네"라는 느낌이 호기심이나 흥미로 연결될 수 있습니다. 차이를 부정하기보다 자연스러운 개성으로 받아들인다면, 의외로 잘 맞는 지점을 발견할 수 있는 궁합입니다.';
    color = '#FFC107';
  }
  // ==================== 85 이상 ====================
  else if (score >= 85) {
    level = '조금 거리감이 있는 궁합 ⚠️';
    message = '대화의 템포나 관심사에서 미묘한 거리감이 느껴질 수 있는 조합입니다. 서로에게 호감이 있어도, 한쪽이 먼저 다가가거나 분위기를 이끌어야 한다고 느낄 가능성이 있습니다. 천천히 상대의 반응을 살펴보면서 간격을 줄여가는 흐름이 어울리는 궁합입니다.';
    color = '#FF7043';
  }
  // ==================== 75 이상 ====================
  else if (score >= 75) {
    level = '노력이 조금 필요한 궁합 🛠️';
    message = '자연스럽게 잘 맞는다기보다는, 서로를 이해하기 위한 작은 노력이 관계에 도움이 되는 궁합입니다. 표현 방식이나 만남의 빈도에서 기대가 다를 수 있어, 한 번쯤 솔직한 대화가 필요할 수 있습니다. 노력의 강도가 크지 않더라도, 방향만 맞으면 충분히 편안한 관계로 이어질 여지는 있습니다.';
    color = '#E65100';
  }
  // ==================== 65 이상 ====================
  else if (score >= 65) {
    level = '속도가 다른 궁합 ⏳';
    message = '호감이 쌓이는 속도나 관계를 진전시키고 싶은 타이밍에서 차이가 나타나기 쉬운 궁합입니다. 한 사람은 빠르게 친해지고 싶어도, 다른 한 사람은 천천히 단계를 밟고 싶어할 수 있습니다. 이 차이를 조급함보다는 스타일의 차이로 받아들일 수 있다면, 부담을 줄이는 데 도움이 됩니다.';
    color = '#BF5F00';
  }
  // ==================== 55 이상 ====================
  else if (score >= 55) {
    level = '다른 매력이 있는 궁합 🔥';
    message = '성향이나 취향이 꽤 다른 편이라, 처음에는 "나와는 좀 다르다"는 느낌이 강하게 올 수 있는 조합입니다. 하지만 그만큼 상대에게서 평소에 보지 못한 모습이나 새로운 관점을 발견하게 될 여지도 있습니다. 공통점보다는 차이에서 매력을 찾는 스타일이라면 흥미롭게 느껴질 수 있는 궁합입니다.';
    color = '#AD1457';
  }
  // ==================== 45 이상 ====================
  else if (score >= 45) {
    level = '취향이 엇갈릴 수 있는 궁합 🎭';
    message = '어떤 대화를 즐기는지, 어떤 만남을 선호하는지에서 생각보다 큰 차이가 느껴질 수 있는 관계입니다. 함께 있어도 각자가 원하는 분위기가 조금씩 다르게 흘러갈 수 있습니다. 서로의 취향을 바꾸려 하기보다는, 어느 정도는 다름을 인정하고 맞출 수 있는지 판단해 볼 필요가 있는 궁합입니다.';
    color = '#E53935';
  }
  // ==================== 35 이상 ====================
  else if (score >= 35) {
    level = '호흡이 맞춰지는 시간이 필요한 궁합 🍃';
    message = '처음 만났을 때는 대화가 어색하거나, 서로에게 어떤 톤과 표현이 잘 맞는지 감이 잘 오지 않을 수 있습니다. 다만 시간을 두고 조금씩 호흡을 맞춰 간다면, 완전히 어울리지 못하는 관계라고 단정할 필요는 없습니다. 서두르지 않고 천천히 흐름을 살펴볼 때 장단점이 분명해지는 궁합입니다.';
    color = '#C62828';
  }
  // ==================== 25 이상 ====================
  else if (score >= 25) {
    level = '감정의 방향을 탐색하는 궁합 🌀';
    message = '서로에게 느끼는 감정이 호감인지, 그냥 편한 상대인지 스스로도 확신하기 어려운 단계일 수 있습니다. 대화를 나누면서 좋은 점과 신경 쓰이는 점이 번갈아 보일 가능성이 있습니다. 조금 더 시간을 두고 지켜봐야 관계의 방향이 더 분명해지는 궁합입니다.';
    color = '#AD1457';
  }
  // ==================== 1 이상 ====================
  else if (score >= 1) {
    level = '서로를 알아가는 데 시간이 더 필요한 궁합 🥀';
    message = '표현 방식과 기대치가 쉽게 맞춰지지 않아, 가까워지는 과정에서 어색함이나 부담이 생기기 쉬운 조합입니다. 서두르기보다는 가볍게 연락을 이어가며 서로의 리듬이 얼마나 다른지 살펴볼 필요가 있습니다. 관계를 억지로 끌고 가기보다는, 편안한 거리에서 바라볼 때 더 객관적으로 느껴질 수 있는 궁합입니다.';
    color = '#8E0038';
  }
  // ==================== 0 이하 ====================
  else {
    level = '많은 배려가 필요한 사이 🚨';
    message = '감정 표현, 관계의 속도, 기대하는 깊이 등에서 차이가 크게 느껴질 수 있는 조합입니다. 서로에게 다가가고 싶은 마음이 있더라도, 방식이 맞지 않아 피로감이나 부담이 쌓이기 쉬울 수 있습니다. 이 점수를 하나의 참고로 두고, 서로의 차이를 얼마나 받아들일 수 있는지 차분히 생각해 볼 필요가 있는 관계입니다.';
    color = '#7F0000';
  }

  // 결과 표시
  compatibilityLevel.innerHTML = '<span style="color: ' + color + '; font-weight: bold;">' + level + '</span>';
  resultMessage.textContent = message;
  scoreCircle.style.borderColor = color;

  // 결과 컨테이너 표시
  document.getElementById('result-container').style.display = 'block';
}

function showLoading() {
  document.getElementById('loading-container').style.display = 'block';
}

function hideLoading() {
  document.getElementById('loading-container').style.display = 'none';
}

function showError(message) {
  hideResult();
  hideLoading();

  document.getElementById('error-message').textContent = message;
  document.getElementById('error-container').style.display = 'block';
}

function hideError() {
  document.getElementById('error-container').style.display = 'none';
}

function hideResult() {
  document.getElementById('result-container').style.display = 'none';
}
</script>

