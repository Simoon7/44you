<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortune For You - 소셜 플랫폼</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="stars-layer-2"></div>
  <header>
    <div class="navbar-container">
      <a href="/" class="navbar-brand">
        💜 Fortune For You
      </a>
      
      <% if (locals.user) { %>
        <nav class="navbar-menu">
          <li><a href="/community">커뮤니티</a></li>
          <li><a href="/analysis">개인 성향 분석</a></li>
          <li><a href="/matching/compatibility">두 사람 궁합 분석</a></li>
          <li><a href="/chat/list">채팅</a></li>
          <li><a href="/block/list">차단 목록</a></li>
        </nav>
        
        <div class="navbar-auth">
          <span><%- user.username %></span>
          <a href="/auth/logout" class="login-btn">로그아웃</a>
        </div>
      <% } else { %>
        <div class="navbar-auth">
          <a href="/" class="login-btn">로그인</a>
          <a href="/auth/signup" class="signup-btn">회원가입</a>
        </div>
      <% } %>
    </div>
  </header>

  <main class="container">
