<%- include('../layout/header') %>

<style>
  /* Community Edit Page with Gradient Background */
  body {
    /* 어두운 그라데이션 배경은 공통 CSS에서 처리 */
    min-height: 100vh;
    margin: 0;
    padding: 0;
  }

  /* body::before는 공통 CSS의 별 레이어로 사용됨 */

  .container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-xl);
  }

  .form-control:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(106, 90, 224, 0.1);
    outline: none;
  }
</style>

<div class="container">
  <!-- 페이지 헤더 -->
  <div style="text-align: center; margin-bottom: var(--spacing-2xl);">
    <h1 style="font-size: 28px; font-weight: 700; color: var(--text-primary); margin: 0 0 var(--spacing-sm) 0;">
      ✏️ 게시글 수정
    </h1>
    <p style="color: var(--text-secondary); font-size: 16px; margin: 0;">
      작성하신 게시글을 수정해주세요
    </p>
  </div>

  <!-- 메인 카드 -->
  <div class="card" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header" style="padding: var(--spacing-lg) var(--spacing-xl); border-bottom: 2px solid var(--border-color);">
      <h2 style="margin: 0; font-size: 20px; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: var(--spacing-xs);">
        📝 게시글 정보 수정
      </h2>
    </div>

    <div class="card-body" style="padding: var(--spacing-2xl);">
      <% if (error) { %>
        <div class="alert alert-danger" style="margin-bottom: var(--spacing-xl);">
          <strong>⚠️ 오류:</strong> <%= error %>
        </div>
      <% } %>

      <form action="/community/<%= post.id %>/edit" method="POST">
        <!-- 제목 입력 -->
        <div class="form-group" style="margin-bottom: var(--spacing-xl);">
          <label for="title" class="form-label" style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-sm); display: block;">
            제목 <span style="color: #ef4444;">*</span>
          </label>
          <input
            type="text"
            id="title"
            name="title"
            class="form-control"
            value="<%= post.title %>"
            placeholder="게시글 제목을 입력하세요"
            required
            style="width: 100%; height: 48px; padding: 0 var(--spacing-md); font-size: 15px; border-radius: 12px; border: 1px solid var(--border-color); transition: all 0.2s ease;"
          >
        </div>

        <!-- 내용 입력 -->
        <div class="form-group" style="margin-bottom: var(--spacing-xl);">
          <label for="content" class="form-label" style="font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: var(--spacing-sm); display: block;">
            내용 <span style="color: #ef4444;">*</span>
          </label>
          <textarea
            id="content"
            name="content"
            class="form-control"
            rows="12"
            placeholder="게시글 내용을 입력하세요"
            required
            style="width: 100%; padding: var(--spacing-md); font-size: 15px; line-height: 1.6; border-radius: 12px; border: 1px solid var(--border-color); transition: all 0.2s ease; resize: vertical; min-height: 300px; font-family: inherit;"
          ><%= post.content %></textarea>
        </div>

        <!-- 버튼 그룹 -->
        <div style="display: flex; gap: var(--spacing-md); justify-content: flex-end; margin-top: var(--spacing-2xl); padding-top: var(--spacing-xl); border-top: 1px solid var(--border-color);">
          <a
            href="/community/<%= post.id %>"
            class="btn btn-outline"
            style="font-size: 15px; padding: 10px 24px; border-radius: 8px; font-weight: 500; text-decoration: none;"
          >
            취소
          </a>
          <button
            type="submit"
            class="btn btn-primary"
            style="font-size: 15px; padding: 10px 24px; border-radius: 8px; font-weight: 600;"
          >
            수정하기
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 추가 정보 -->
  <div style="text-align: center; margin-top: var(--spacing-xl); color: var(--text-secondary); font-size: 14px;">
    💡 수정된 내용은 즉시 반영됩니다. 신중하게 작성해주세요.
  </div>
</div>

<%- include('../layout/footer') %>

