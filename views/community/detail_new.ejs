<%- include('../layout/header') %>

<% if (locals.error) { %>
  <div class="alert alert-danger">
    <%= error %>
  </div>
<% } %>

<% if (locals.success) { %>
  <div class="alert alert-success">
    <%= success %>
  </div>
<% } %>

<div class="card" style="max-width: 800px; margin: 2rem auto;" data-post-author-id="<%= post.userId %>">
  <div class="card-header">
    <h2><%= post.title %></h2>
    <div class="post-meta" style="margin-top: 1rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        👤 <%= post.author?.username || post.User?.username || '알 수 없음' %>
        <% if (locals.user && user.id !== post.userId) { %>
          <div class="post-user-menu-container" style="position: relative;">
            <button 
              class="ellipsis-btn" 
              onclick="togglePostUserMenu(<%= post.userId %>, '<%= ((post.author?.username || post.User?.username) || '알 수 없음').replace(/'/g, "\\'") %>')"
              style="background: none; border: none; cursor: pointer; padding: 0.25rem 0.5rem; font-size: 1rem; color: var(--text-secondary); line-height: 1;"
              title="더보기"
            >
              ⋮
            </button>
            <div id="post-user-menu-<%= post.userId %>" class="user-menu" style="display: none; position: absolute; left: 0; top: 100%; background: white; border: 1px solid #ddd; border-radius: 0.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.15); z-index: 1000; min-width: 150px; margin-top: 0.25rem;">
              <button onclick="blockUser(<%= post.userId %>, '<%= ((post.author?.username || post.User?.username) || '알 수 없음').replace(/'/g, "\\'") %>', <%= post.userId %>)" style="width: 100%; padding: 0.75rem; border: none; background: none; text-align: left; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='#f5f5f5'" onmouseout="this.style.background='white'">
                🚫 차단하기
              </button>
            </div>
          </div>
        <% } %>
      </div>
      <div>📅 <%= post.createdAt?.toLocaleDateString('ko-KR') %></div>
      <div>👁️ <%= post.views || 0 %>회</div>
    </div>
  </div>

  <div class="card-body">
    <div style="line-height: 1.8; color: var(--text-primary); white-space: pre-wrap; word-break: break-word;">
      <%= post.content %>
    </div>
  </div>

  <% if (locals.user && user.id === post.userId) { %>
    <div style="padding: 1.5rem; background-color: var(--light-bg); border-top: 1px solid var(--border-color); display: flex; gap: 1rem;">
      <a href="/community/<%= post.id %>/edit" class="btn btn-primary">
        수정
      </a>
      <form method="POST" action="/community/<%= post.id %>/delete" style="display: inline;">
        <button type="submit" class="btn btn-danger" onclick="return confirm('정말 삭제하시겠습니까?');">
          삭제
        </button>
      </form>
    </div>
  <% } %>
</div>

<!-- 댓글 섹션 -->
<div class="card" style="max-width: 800px; margin: 2rem auto;">
  <div class="card-header">
    <h3>💬 댓글 
      <% 
        // 재귀적으로 모든 댓글 수 계산
        function countComments(comments) {
          let count = 0;
          if (comments) {
            comments.forEach(comment => {
              count += 1;
              if (comment.replies && comment.replies.length > 0) {
                count += countComments(comment.replies);
              }
            });
          }
          return count;
        }
        const totalCommentCount = countComments(post.comments);
      %>
      (<%= totalCommentCount %>)
    </h3>
  </div>

  <% if (locals.user) { %>
    <form method="POST" action="/community/<%= post.id %>/comment" style="padding: 2rem; border-bottom: 1px solid var(--border-color);">
      <input type="hidden" name="postId" value="<%= post.id %>">
      <div class="form-group">
        <label for="comment" class="form-label">댓글 작성</label>
        <textarea 
          id="comment" 
          name="content" 
          class="form-control" 
          placeholder="댓글을 입력하세요"
          rows="3"
          required
        ></textarea>
      </div>
      <button type="submit" class="btn btn-primary">
        댓글 작성
      </button>
    </form>
  <% } else { %>
    <div style="padding: 2rem; text-align: center; background-color: var(--light-bg); color: var(--text-secondary);">
      <p>댓글을 작성하려면 <a href="/auth/login" style="color: var(--primary-color); font-weight: 600;">로그인</a>해주세요.</p>
    </div>
  <% } %>

  <% if (post.comments && post.comments.length > 0) { %>
    <div style="padding: 2rem;">
      <% post.comments.forEach(comment => { %>
        <%- include('_comment', { comment: comment, depth: 0, post: post, user: user }); %>
      <% }); %>
    </div>
  <% } else { %>
    <div style="padding: 2rem; text-align: center; color: var(--text-secondary);">
      첫 번째 댓글을 작성해보세요!
    </div>
  <% } %>
</div>

<div style="text-align: center; margin: 2rem 0;">
  <a href="/community/list" class="btn btn-outline">
    목록으로 돌아가기
  </a>
</div>

<!-- 차단 기능 -->
<script src="/js/blockReport.js"></script>

<script>
// 답글 폼 토글 함수
function toggleReplyForm(commentId) {
  const replyForm = document.getElementById(`reply-form-${commentId}`);
  if (replyForm) {
    replyForm.style.display = replyForm.style.display === 'none' ? 'block' : 'none';
  }
}
</script>

<%- include('../layout/footer') %>

